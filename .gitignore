# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# access-code drop send log (emails + codes — never commit)
/scripts/.mint-send-log.json

# typescript
*.tsbuildinfo
next-env.d.ts

# claude
.claude/

# Local-only assets not used by the site (keep the repo lean)
# Product photos live on Shopify's CDN; brand fonts live in src/fonts/.
/public/Images/
/public/Hero Inspiration.png
/public/STORY DUSK.docx
/public/expansiva.zip
/public/expansiva/

# Uncompressed source videos — the site serves the compressed ones already tracked
/public/videos/Hero new video 2 - Mobile.mp4
/public/videos/New hero video 1 - Desktop.mp4
/public/videos/Fabric_shards*
